# ==== Base de datos (Neon Postgres) ====
# La agrega automáticamente la integración de Neon en Vercel (no la cargues a mano).
# DATABASE_URL=postgres://...

# ==== Odoo (carga de pedidos como presupuesto borrador) ====
ODOO_URL=https://gpowerbyte-luminatec.odoo.com
ODOO_DB=gpowerbyte-luminatec
ODOO_USER=ivarela@luminatec.com
ODOO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
ODOO_COMPANY_ID=6
# ODOO_SALESPERSON_UID=   (opcional)

# ==== Sesión / seguridad ====
APP_SECRET=frase-larga-y-secreta         # firma los tokens de sesión

# ==== Alta inicial de usuarios (una sola vez, endpoint /api/setup) ====
SETUP_TOKEN=token-secreto-para-sembrar    # se usa una vez y después se puede borrar
ADMIN_INITIAL_PASSWORD=clave-inicial-admin# clave de Nacho para el 1er ingreso (la cambia al entrar)
ADMIN_EMAIL=ivarela@luminatec.com         # (opcional) mail del admin
# ADMIN_NAME=Nacho Varela                  # (opcional)

# ==== Mail (Resend) — recuperación de contraseña y envío de pedidos ====
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
MAIL_FROM=info@luminatec.com              # remitente de un dominio verificado en Resend
MAIL_TO=mburastero@luminatec.com,mmagenta@luminatec.com,mmusante@luminatec.com

# ==== (Obsoleto) login por clave compartida ====
# Ya no se usan: el login ahora valida contra la base de datos de usuarios.
# VENDOR_PASSWORDS=
# TEAM_PASSWORD=
